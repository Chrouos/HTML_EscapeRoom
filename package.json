{
  "name": "last",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:unit": "find test/unit -name '*.test.js' -print0 | xargs -0 node --test",
    "test:integration": "find test/integration -name '*.test.js' -print0 | xargs -0 node --test",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.js",
    "check": "npm run validate:content && npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.6",
    "express": "^4.17.2",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
