<section class="monitor-frame operations-monitor" role="region" aria-labelledby="operations-monitor-heading">
  <div class="monitor-casing">
    <header class="monitor-header">
      <h2 id="operations-monitor-heading">MONITOR 02 / OPERATIONS</h2>
      <span class="monitor-status"><span class="status-light status-light-amber" aria-hidden="true"></span>CONSOLE READY</span>
    </header>
    <div class="monitor-bezel">
      <div class="monitor-screen operations-screen">
        <section data-operations-workspace class="operations-workspace" role="region" aria-labelledby="operations-workspace-heading">
          <h3 id="operations-workspace-heading" class="visually-hidden">Operations workspace</h3>
          <p class="operations-scroll-cue" aria-hidden="true">CONSOLE BUFFER // 向下探索更多紀錄</p>
          <section data-workstation class="terminal-panel workstation-panel" aria-labelledby="workstation-heading">
            <div class="panel-heading"><span class="panel-index">00 / WORKSTATION</span><h2 id="workstation-heading">FILES · TERMINAL · LOGS</h2></div>
          </section>
          <section data-puzzle-gate class="terminal-panel puzzle-panel" aria-labelledby="puzzle-heading" hidden>
            <div class="panel-heading"><span class="panel-index">01 / SECURE RESPONSE</span><h2 id="puzzle-heading">ANSWER CONSOLE</h2></div>
            <div data-audio></div>
            <form data-action-form>
              <p data-prompt class="puzzle-prompt"></p>
              <label for="value">提交答案</label>
              <input id="value" name="value" maxlength="1000" required autocomplete="off" placeholder="和另一位玩家比對後送出">
              <button class="button button-primary" type="submit" disabled>送出</button>
              <p data-feedback class="feedback" role="status"></p>
            </form>
          </section>
          <%- include('evidencePanel') %>
          <section class="terminal-panel side-panel" aria-labelledby="side-heading">
            <div class="panel-heading"><span class="panel-index">03 / RECORDS</span><h2 id="side-heading">異常紀錄</h2></div>
            <p class="muted">不影響主線。值得多看一眼的地方，往往不在指示裡。</p>
            <div data-sides></div>
          </section>
        </section>
      </div>
    </div>
  </div>
</section>
