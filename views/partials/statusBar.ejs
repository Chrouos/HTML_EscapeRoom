<div class="status-bar" aria-label="房間狀態">
  <div class="status-plaque status-identity" aria-label="房間門牌">
    <span class="status-key">ROOM / 房號</span>
    <strong class="status-room"><%= roomCode %></strong>
    <span class="status-role">TERMINAL <%= state.role %></span>
    <span class="visually-hidden">角色 <%= state.role %></span>
  </div>
  <div class="status-stage"><span class="status-key">EXPERIMENT / 實驗階段</span><strong data-stage class="status-value">設施初始化</strong></div>
  <div class="status-timer" aria-label="隔離倒數">
    <span class="status-key">CONTAINMENT / 隔離倒數</span>
    <strong data-countdown class="countdown">等待連線</strong>
  </div>
</div>
<div class="connection-band"><span class="readout-dot" aria-hidden="true"></span><span data-connection role="status">正在連接終端機</span><span data-occupancy class="muted">房間狀態：<%= state.occupancy.ready ? '兩位玩家已就緒' : '等待另一位玩家加入' %></span></div>
