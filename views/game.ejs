<section data-game-room="<%= roomCode %>" class="game-shell role-<%= state.role.toLowerCase() %>" aria-label="研究終端">
  <%- include('partials/statusBar', { roomCode, state }) %>
  <section data-ending class="ending-panel terminal-panel full-shell-layer" aria-label="實驗結局" hidden></section>
  <div class="monitor-selector">
    <div class="monitor-tabs" role="radiogroup" aria-label="Monitor selection">
      <input class="monitor-tab-input" type="radio" name="active-monitor" id="monitor-intercom" checked>
      <label class="monitor-tab" for="monitor-intercom">Intercom</label>
      <input class="monitor-tab-input" type="radio" name="active-monitor" id="monitor-operations">
      <label class="monitor-tab" for="monitor-operations">Operations</label>
    </div>
    <div class="workstation-shell">
      <%- include('partials/intercomMonitor') %>
      <%- include('partials/operationsMonitor') %>
    </div>
  </div>
</section>
<script src="/public/js/game.js" defer></script>
